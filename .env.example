# EkoMeet Environment Variables
# Copy this file to .env and fill in your actual values

# Amap API Configuration (Required)
# Get your API key from: https://console.amap.com/dev/key/app
AMAP_API_KEY=your_amap_api_key_here
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# Optional: Port configuration (defaults to 8000)
PORT=8000

# 硅基流动 API 配置 (Required for Eko AI)
# 获取API密钥: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI Compatible Configuration
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo

# Eko Framework Configuration
EKO_MODEL=Qwen/Qwen2.5-72B-Instruct
EKO_BASE_URL=https://api.siliconflow.cn/v1

# Optional: Log level
LOG_LEVEL=info
