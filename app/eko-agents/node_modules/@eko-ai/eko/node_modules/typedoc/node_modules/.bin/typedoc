#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules/typedoc/bin/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules/typedoc/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules/typedoc/bin/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules/typedoc/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/typedoc@0.27.9_typescript@5.9.2/node_modules:/mnt/d/AI_coding/MeetSpot/eko/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/typedoc" "$@"
else
  exec node  "$basedir/../../bin/typedoc" "$@"
fi
